{
  "name": "extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LightMove Capture — the Chrome extension that writes a company or a person from the open page into a mandate",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run clean && npm run build:parts && (vite build --watch --mode development & npm run watch:parts)",
    "build": "tsc --noEmit && npm run clean && vite build && npm run build:parts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "build:parts": "vite build --config vite.page-reader.config.ts",
    "watch:parts": "vite build --watch --config vite.page-reader.config.ts",
    "build:release": "node scripts/packageRelease.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
