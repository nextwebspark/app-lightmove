{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": { "type": "string" },
          "better": { "type": "string", "enum": ["A", "B", "tie"] },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["criterion", "better", "reason"]
      }
    }
  },
  "required": ["picks"]
}
