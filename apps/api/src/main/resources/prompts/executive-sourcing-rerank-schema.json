{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hit": { "type": "integer" },
          "score": { "type": "integer" },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["hit", "score"]
      }
    },
    "note": { "type": ["string", "null"] }
  },
  "required": ["picks"]
}
