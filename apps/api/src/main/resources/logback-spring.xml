<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log format, and only the format — levels stay in application.yml where they are configurable.

  Two shapes, because the reader is different. Locally the reader is a human staring at a terminal, so
  Spring's own colourised pattern wins. Deployed, the reader is Cloud Logging, which parses stdout: hand
  it JSON and every line becomes queryable by severity and by correlationId — hand it plain text and it
  gets one opaque `textPayload` per line, every entry filed as INFO, and no way to ask "show me this
  request".

  `e2e` belongs with `local`, and the reason is not cosmetic. The matrix reads verification, reset and
  invitation links out of this log — LogEmailSender prints a box whose `To:` line precedes the link, and
  e2e/api/lib.sh separates the two by *line*. Under the JSON encoder the whole box collapses into one
  escaped `message` string, so no token is ever found and every path that starts with an emailed link
  fails at once. That is how it was discovered: 335 failures, one cause.

  The field names are Cloud Logging's, not ours (`severity`, `time`, `message`). It looks for exactly
  these; anything else lands in jsonPayload as decoration.
-->
<configuration>

    <springProfile name="local,test,e2e">
        <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- No profile is the deployed case: the container runs `java -jar` with none set. -->
    <springProfile name="!local &amp; !test &amp; !e2e">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>time</fieldName>
                        <timeZone>UTC</timeZone>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                    </timestamp>
                    <pattern>
                        <omitEmptyFields>true</omitEmptyFields>
                        <!--
                          Cloud Logging's LogSeverity enum has WARNING, not Logback's WARN. Left as-is the
                          line is filed as DEFAULT and a warning stops looking like a warning in the
                          console — so translate it here rather than discovering it during an incident.

                          The MDC keys are named one by one, never the whole map: a stray key set anywhere
                          must not put its value in the JSON. Ids only — never an email or a name.

                          The logging.googleapis.com/* fields nest the line under Cloud Run's request entry.
                          trace_sampled must be a JSON boolean, and #asBoolean answers null for an absent
                          key, which omitEmptyFields drops like an empty string.
                        -->
                        <pattern>
                            {
                              "severity": "%replace(%level){'WARN','WARNING'}",
                              "logger": "%logger{40}",
                              "thread": "%thread",
                              "correlationId": "%mdc{correlationId}",
                              "userId": "%mdc{userId}",
                              "workspaceId": "%mdc{workspaceId}",
                              "projectId": "%mdc{projectId}",
                              "logging.googleapis.com/trace": "%mdc{gcpTrace}",
                              "logging.googleapis.com/spanId": "%mdc{gcpSpanId}",
                              "logging.googleapis.com/trace_sampled": "#asBoolean{%mdc{gcpTraceSampled}}"
                            }
                        </pattern>
                    </pattern>
                    <message/>
                    <stackTrace/>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>
