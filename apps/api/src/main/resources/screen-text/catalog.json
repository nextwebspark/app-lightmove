{
  "format": "lightmove.screen-text-catalog",
  "formatVersion": 1,
  "neverOnScreen": [
    "\\bNylas\\b",
    "\\bthis deployment\\b",
    "\\btriage\\b"
  ],
  "screens": [
    {
      "id": "errors-general",
      "title": "Error messages · Everywhere"
    },
    {
      "id": "errors-account",
      "title": "Error messages · Account and workspace"
    },
    {
      "id": "errors-positions",
      "title": "Error messages · Positions and the market"
    },
    {
      "id": "errors-candidates",
      "title": "Error messages · Candidates and pipeline"
    },
    {
      "id": "errors-outreach",
      "title": "Error messages · Outreach, mailbox and meetings"
    },
    {
      "id": "errors-billing",
      "title": "Error messages · Billing and credits"
    },
    {
      "id": "errors-settings",
      "title": "Error messages · Settings"
    }
  ],
  "entries": [
    {
      "key": "errors-general.generic",
      "screen": "errors-general",
      "kind": "error",
      "where": "Any failure with no reference to quote",
      "defaultText": "Something went wrong. Try again.",
      "placeholders": [],
      "maxLength": 300
    },
    {
      "key": "errors-general.unexpected",
      "screen": "errors-general",
      "kind": "error",
      "where": "Any failure we did not expect; {reference} is the request's support reference",
      "defaultText": "Something went wrong on our side. Try again, or contact support and quote reference {reference}.",
      "placeholders": [
        "reference"
      ],
      "maxLength": 300
    },
    {
      "key": "errors-general.unsavedChanges",
      "screen": "errors-general",
      "kind": "error",
      "where": "An action that first had to save the screen's edits, when that save was refused",
      "defaultText": "Couldn't save your last change. Check your connection and try again.",
      "placeholders": [],
      "maxLength": 300
    },
    {
      "key": "errors-general.FORBIDDEN",
      "screen": "errors-general",
